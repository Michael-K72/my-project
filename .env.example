# Public site URL used for canonical metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://michaelkalachin.ch

# Optional: Stripe TEST secret. When unset, checkout uses the demo payment adapter.
# Never commit a live key. Never prefix a secret with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Optional: email provider. When unset, contact/booking persist as demo receipts.
RESEND_API_KEY=
RESEND_FROM=hello@michaelkalachin.ch
